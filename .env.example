# Run: bash scripts/init-env.sh (generates secrets; do not commit .env)
POSTGRES_DB=bluewaikiki_map
POSTGRES_USER=map_admin
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
MAP_API_TOKEN=REPLACE_WITH_RANDOM_SECRET
API_HOST_PORT=18083
IMPORT_START_HOUR=1
IMPORT_END_HOUR=5
IMPORT_CHECK_SECONDS=300
IMPORT_MAX_LOAD_1M=1.5
IMPORT_MAX_UNCOMPRESSED_BYTES=4294967296
MAP_UID=1000
MAP_GID=1000
MAP_RUN_SCHEDULER=1
MAP_DATA_DIR=/data
MAP_DOWNLOADER=disabled
